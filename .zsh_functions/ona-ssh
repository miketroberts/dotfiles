cleanup() {

    # Disable mouse tracking
    printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l'

    # Restore terminal settings
    stty sane 2>/dev/null
}

trap cleanup EXIT INT TERM

local env_id env_name
env_id=$(ona environment list \
    | tail -n +2 \
    | fzf --prompt='Select Gitpod env > ' --height=25% --layout=reverse --border \
    | awk '{print $1}')

[ -z "$env_id" ] && return

env_name=$(ona environment list -o json \
    | jq -r --arg id "$env_id" '.[] | select(.id == $id) | .metadata.name | rtrimstr("\n")')

set-title "${env_name:-$env_id}" && ona environment ssh "$env_id" --start -- -t "tmux new -A -s $env_id"
